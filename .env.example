# GitHub personal access tokens, one per configured account (server/config.ts).
# Fine-grained PAT permissions needed: Contents: Read-only + Metadata: Read-only.
# Tokens are read server-side only and never reach the browser bundle.
GITHUB_TOKEN_ECY_CODING=""
GITHUB_TOKEN_ADOBEMRE1=""

# Network binding. Loopback by default — this is a personal local tool.
# Set HOST=0.0.0.0 only in a sandboxed container (e.g. AI Studio preview).
HOST="127.0.0.1"
PORT="3000"

# Search journal (found-words notebook). Set to "false" to disable journaling.
JOURNAL_ENABLED="true"
